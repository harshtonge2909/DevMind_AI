# DevMind AI - Environment Configuration Example
# Copy this file to '.env' and provide your Google Gemini API key.
# DevMind AI supports either 'Gemini_API_Key' or 'GOOGLE_API_KEY'.

# Google Gemini API Key (Obtain from https://aistudio.google.com/)
Gemini_API_Key=your_gemini_api_key_here

# Alternatively:
# GOOGLE_API_KEY=your_gemini_api_key_here

# Optional model configurations (defaults shown below)
# DEVMIND_MODEL=gemini-3.6-flash
# DEVMIND_EMBEDDING_MODEL=gemini-embedding-001
# DEVMIND_CHUNK_SIZE=500
# DEVMIND_CHUNK_OVERLAP=50
# DEVMIND_TOP_K=4
